<fieldset id="payment-method-<%= payment_method.id %>" class="ipay-payment-method">
  <legend class="payment-method-name">
    <%= payment_method.name %>
  </legend>

  <% if @order.remaining_balance < @order.total %>
    <div class="alert alert-info">
      <i class="fa fa-info-circle"></i>
      You have already paid <strong><%= number_to_currency(@order.total - @order.remaining_balance) %></strong>.
      Remaining balance to pay: <strong><%= number_to_currency(@order.remaining_balance) %></strong>
    </div>
  <% end %>

  <div class="payment-method-description mb-3">
    <p><%= Spree.t(:ipay_description) %></p>
  </div>

  <div class="form-group">
    <%= label_tag "order[payments_attributes][][source_attributes][phone]", Spree.t(:phone_number), class: "required" %>
    <%= telephone_field_tag "order[payments_attributes][][source_attributes][phone]", 
                          session[:ipay_phone_number] || @order.bill_address&.phone, 
                          class: "form-control", 
                          required: true, 
                          id: "ipay_phone_number", 
                          pattern: "\\d{10}", 
                          maxlength: 10, 
                          minlength: 10, 
                          autocomplete: "tel",
                          placeholder: "07XXXXXXXX" %>
    <small class="form-text text-muted">
      Enter your 10-digit mobile money number
    </small>
    <div id="ipay-phone-error" class="text-danger" style="display:none;"></div>
  </div>

  <div class="alert alert-info mt-3">
    <i class="fa fa-info-circle"></i>
    You will be charged: <strong><%= number_to_currency(@order.remaining_balance) %></strong>
  </div>
</fieldset>

<script>
  $(document).ready(function() {
    // Format phone number input
    $('#ipay_phone_number').on('input', function() {
      var value = $(this).val().replace(/\D/g, '');
      $(this).val(value);
    });

    // Form validation
    $('#checkout_form_payment').on('submit', function(e) {
      if ($('#payment_method_<%= payment_method.id %>').is(':checked')) {
        var phone = $('#ipay_phone_number').val();
        if (!/^\d{10}$/.test(phone)) {
          phoneError.text('Please enter a valid 10-digit mobile number.').show();
          $('#ipay_phone_number').focus();
          e.preventDefault();
          return false;
        } else {
          phoneError.hide();
        }
        $(this).find('input[type="submit"]').prop('disabled', true).val('Redirecting to iPay...');
        $(this).attr('data-turbo', 'false');
        $(this).removeAttr('data-remote');
      }
    });
  });
</script>
