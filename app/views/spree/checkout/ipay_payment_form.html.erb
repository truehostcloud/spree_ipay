<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <div class="text-center mb-4">
            <h2 class="h4 mb-3">Processing Your Payment</h2>
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3 mb-0">Redirecting to iPay secure payment page...</p>
          </div>

          <!-- Hidden form that will be auto-submitted -->
          <%= form_tag @payment_url, method: :post, id: 'ipay-payment-form', class: 'd-none' do %>
            <% @form_fields.each do |name, value| %>
              <%= hidden_field_tag name, value, id: "ipay_#{name}" %>
            <% end %>
            <%= submit_tag 'Submit Payment', id: 'submit-button' %>
          <% end %>

          <!-- Debug Information (initially hidden) -->
          <div class="mt-4">
            <button type="button" class="btn btn-sm btn-outline-secondary" id="toggle-debug">
              <i class="bi bi-bug"></i> Show Debug Info
            </button>
            <div id="debug-info" class="mt-3 p-3 bg-light rounded d-none">
              <h5 class="h6 mb-3">Debug Information</h5>
              <div class="mb-2">
                <strong>Endpoint:</strong>
                <code class="d-block mt-1"><%= @payment_url %></code>
              </div>
              <div class="mb-2">
                <strong>Form Fields:</strong>
                <pre class="bg-white p-2 rounded border mt-1"><%= JSON.pretty_generate(@form_fields.to_h) %></pre>
              </div>
              <div class="alert alert-warning small mb-0">
                <i class="bi bi-exclamation-triangle-fill"></i>
                This information is for debugging purposes only. Do not share this information.
              </div>
            </div>
          </div>

          <!-- Error message container -->
          <div id="error-message" class="alert alert-danger mt-4 d-none" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <span id="error-text"></span>
            <div class="mt-2">
              <button class="btn btn-sm btn-outline-danger" onclick="window.location.reload()">
                <i class="bi bi-arrow-clockwise"></i> Try Again
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Enhanced debug toggle with better error handling
  function toggleDebug() {
    try {
      const debugInfo = document.getElementById('debug-info');
      if (!debugInfo) {
        console.warn('Debug info element not found');
        return;
      }
      const isHidden = debugInfo.classList.toggle('d-none');
      const toggleBtn = document.getElementById('toggle-debug');
      if (toggleBtn) {
        toggleBtn.innerHTML = isHidden ? 
          '<i class="bi bi-bug"></i> Show Debug Info' : 
          '<i class="bi bi-eye-slash"></i> Hide Debug Info';
      }
    } catch (error) {
      console.error('Error toggling debug info:', error);
    }
  }
  
  // Show error message to user
  function showError(message) {
    try {
      console.error('iPay Error:', message);
      
      const errorText = document.getElementById('error-text');
      const errorMessage = document.getElementById('error-message');
      const spinner = document.querySelector('.spinner-border');
      
      if (errorText) errorText.textContent = message;
      if (errorMessage) errorMessage.classList.remove('d-none');
      if (spinner) spinner.style.display = 'none';
    } catch (e) {
      console.error('Error showing error message:', e);
    }
  }
  
  // Submit form with error handling
  function submitPaymentForm() {
    const form = document.getElementById('ipay-payment-form');
    if (!form) {
      showError('Payment form not found. Please try refreshing the page.');
      return false;
    }
    
    try {
      // Show loading state
      const submitBtn = form.querySelector('input[type="submit"]');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.value = 'Processing...';
      }
      
      // Submit the form
      form.submit();
      
      // If still here after submission, show a message
      setTimeout(() => {
        if (submitBtn) {
          submitBtn.value = 'Redirecting...';
        }
      }, 2000);
      
      return true;
    } catch (error) {
      console.error('Form submission error:', error);
      showError('Failed to submit payment. Please try again.');
      return false;
    }
  }
  
  // Main initialization
  document.addEventListener('DOMContentLoaded', function() {
    console.log('iPay payment form loaded');
    const form = document.getElementById('ipay-payment-form');
    const toggleDebugBtn = document.getElementById('toggle-debug');
    
    if (!form) {
      showError('Payment system error: Could not initialize payment form.');
      return;
    }
    
    // Toggle debug info
    if (toggleDebugBtn) {
      toggleDebugBtn.addEventListener('click', toggleDebug);
    }
    
    // Handle URL error parameters
    try {
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.has('error')) {
        showError(decodeURIComponent(urlParams.get('error')));
      }
    } catch (e) {
      console.error('Error parsing URL parameters:', e);
    }
    
    // Add manual submit button as fallback
    const manualSubmit = document.createElement('div');
    manualSubmit.className = 'mt-3 text-center';
    manualSubmit.innerHTML = `
      <p class="text-muted small mb-2">If you're not redirected automatically:</p>
      <button type="button" onclick="submitPaymentForm()" 
              class="btn btn-primary">
        Proceed to iPay
      </button>
    `;
    
    // Insert the manual submit button
    if (form.parentNode) {
      form.parentNode.insertBefore(manualSubmit, form.nextSibling);
    }
    
    // Auto-submit the form after a short delay
    setTimeout(submitPaymentForm, 1000);
  });
</script>
